# Safe default: the full conversation + multi-Agent flow runs locally without paid API calls.
ARTFLOW_AGENT_BACKEND=mock
ARTFLOW_IMAGE_BACKEND=mock

# Qwen Beijing region. Fill both values locally; never paste the key into chat or source code.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Optional: the API Host shown by Model Studio. Use the host only, without endpoint paths.
DASHSCOPE_API_HOST=
DASHSCOPE_REGION=cn-beijing
QWEN_CHAT_MODEL=qwen-plus
QWEN_IMAGE_MODEL=qwen-image-2.0
QWEN_PROMPT_EXTEND=true
QWEN_WATERMARK=false
QWEN_TIMEOUT_SECONDS=180
QWEN_MAX_CONCURRENCY=2
QWEN_CONTEXT_MAX_TOKENS=12000
QWEN_CONTEXT_RECENT_TURNS=8

# Five-layer Context Engine. These local defaults need no cloud service.
ARTFLOW_STORAGE_DIR=
ARTFLOW_BLOB_BACKEND=local
ARTFLOW_VECTOR_BACKEND=local
ARTFLOW_EMBEDDING_BACKEND=hash
ARTFLOW_EMBEDDING_DIMENSION=768
ARTFLOW_AUTO_COMPACT_RATIO=0.75
ARTFLOW_ARTIFACT_INLINE_CHARS=4000
ARTFLOW_MEMORY_TOP_K=6
QWEN_EMBEDDING_MODEL=text-embedding-v4

# Optional remote storage (install requirements-remote.txt first).
# ARTFLOW_BLOB_BACKEND=oss
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PREFIX=artflow
# ARTFLOW_VECTOR_BACKEND=milvus
# ARTFLOW_EMBEDDING_BACKEND=qwen
# MILVUS_URI=
# MILVUS_TOKEN=
# MILVUS_COLLECTION=artflow_memories

# Optional legacy ComfyUI compatibility. It is not required by the Qwen path.
ARTFLOW_BASE_MODEL=z-image.safetensors
ARTFLOW_DEFAULT_LORA=dark_alchemy_v1.safetensors
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TEMPLATE_PATH=
COMFYUI_TIMEOUT_SECONDS=300
COMFYUI_POLL_INTERVAL=0.5
COMFYUI_API_KEY=
